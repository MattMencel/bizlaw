#!/usr/bin/env ruby
# The game view is served by Vite in development, so `bin/dev` runs the Rails
# server and the Vite dev server together rather than Rails alone. foreman
# defaults PORT to 5000; Rails' own default is what everything else here
# assumes.
ENV["PORT"] ||= "3000"
exec "bundle", "exec", "foreman", "start", "-f", "Procfile.dev", *ARGV
